{
  "name": "adaptix-website",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptix Educational Solutions website and enquiry service on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply adaptix-enquiries --local",
    "migrate:remote": "wrangler d1 migrations apply adaptix-enquiries --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261025.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  }
}
